<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Pulsemap.App.Controls"
    xmlns:vm="using:Pulsemap.App.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Bind ViewModel.SurveyNameDisplay, Mode=OneWay}" FontSize="{StaticResource FontSize2xl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                <TextBlock Text="{x:Bind ViewModel.SurveyTypeDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray500Brush}" Margin="0,4,0,0" />
                <TextBlock Text="{x:Bind ViewModel.CoveragePercentDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray500Brush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="WorkspaceSaveSnapshotButton" Click="SaveSnapshot_Click" />
                <Button x:Uid="WorkspaceCompareSnapshotsButton" Click="CompareSnapshots_Click" />
                <Button x:Uid="WorkspaceExportMenuButton">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Uid="WorkspaceExportTestPointsCsvMenuItem" Command="{x:Bind ViewModel.ExportTestPointsCsvCommand}" />
                            <MenuFlyoutItem x:Uid="WorkspaceExportAccessPointsCsvMenuItem" Command="{x:Bind ViewModel.ExportAccessPointsCsvCommand}" />
                            <MenuFlyoutItem x:Uid="WorkspaceExportSurveyJsonMenuItem" Command="{x:Bind ViewModel.ExportSurveyJsonCommand}" />
                            <MenuFlyoutItem x:Uid="WorkspaceExportCoverageReportPdfMenuItem" Command="{x:Bind ViewModel.ExportCoverageReportPdfCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="WorkspaceBackButton" Click="Back_Click" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="0,12,0,0" />

        <InfoBar
            Grid.Row="1"
            Severity="Informational"
            IsOpen="{x:Bind ViewModel.CanUndoDelete, Mode=OneWay}"
            Message="{x:Bind ViewModel.LastDeletedItemDisplay, Mode=OneWay}"
            Margin="0,12,0,0">
            <InfoBar.ActionButton>
                <Button x:Uid="WorkspaceUndoDeleteButton" Command="{x:Bind ViewModel.UndoDeleteCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,20,0,0" VerticalAlignment="Center">
            <ToggleButton x:Uid="WorkspaceSelectToolButton" x:Name="SelectToolButton" Checked="ToolToggle_Checked" />
            <ToggleButton x:Uid="WorkspaceAddTestPointToolButton" x:Name="AddTestPointToolButton" Checked="ToolToggle_Checked" />
            <ToggleButton x:Uid="WorkspaceDrawWallToolButton" x:Name="DrawWallToolButton" Checked="ToolToggle_Checked" />
            <ToggleButton x:Uid="WorkspaceDeleteToolButton" x:Name="DeleteToolButton" Checked="ToolToggle_Checked" />
            <ToggleButton x:Uid="WorkspaceDiagnoseToolButton" x:Name="DiagnoseToolButton" Checked="ToolToggle_Checked" />

            <Button x:Name="ToolLegendButton" x:Uid="WorkspaceToolLegendButton" Margin="8,0,0,0">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="10" MaxWidth="320">
                            <TextBlock x:Uid="WorkspaceToolLegendTitle" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="WorkspaceToolLegendSelectHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                <TextBlock x:Uid="WorkspaceToolLegendSelectBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray700Brush}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="WorkspaceToolLegendAddTestPointHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                <TextBlock x:Uid="WorkspaceToolLegendAddTestPointBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray700Brush}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="WorkspaceToolLegendDrawWallHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                <TextBlock x:Uid="WorkspaceToolLegendDrawWallBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray700Brush}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="WorkspaceToolLegendDeleteHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                <TextBlock x:Uid="WorkspaceToolLegendDeleteBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray700Brush}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="WorkspaceToolLegendDiagnoseHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                <TextBlock x:Uid="WorkspaceToolLegendDiagnoseBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray700Brush}" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ComboBox x:Name="BandSelector" Width="120" Margin="16,0,0,0" SelectionChanged="BandSelector_SelectionChanged" />

            <ComboBox
                Width="160"
                Margin="8,0,0,0"
                ItemsSource="{x:Bind ViewModel.Floors, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFloor, Mode=TwoWay}"
                DisplayMemberPath="Name" />
            <Button x:Uid="WorkspaceAddFloorButton" Click="AddFloor_Click" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" Margin="8,0,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasWallSelection, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.WallSelectionCountDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                <ComboBox x:Name="WallMaterialSelector" Width="170" SelectedIndex="0">
                    <ComboBoxItem x:Uid="WorkspaceWallMaterialUnspecified" Tag="" />
                    <ComboBoxItem x:Uid="WizardWallMaterialDrywall" Tag="Drywall" />
                    <ComboBoxItem x:Uid="WizardWallMaterialGlassStandard" Tag="GlassStandard" />
                    <ComboBoxItem x:Uid="WizardWallMaterialGlassLowE" Tag="GlassLowE" />
                    <ComboBoxItem x:Uid="WizardWallMaterialWood" Tag="Wood" />
                    <ComboBoxItem x:Uid="WizardWallMaterialBrick" Tag="Brick" />
                    <ComboBoxItem x:Uid="WizardWallMaterialConcrete" Tag="Concrete" />
                    <ComboBoxItem x:Uid="WizardWallMaterialReinforcedConcrete" Tag="ReinforcedConcrete" />
                </ComboBox>
                <NumberBox x:Name="WallThicknessInput" Width="110" PlaceholderText="m" SpinButtonPlacementMode="Compact" SmallChange="0.01" Minimum="0" />
                <Button x:Uid="WorkspaceApplyWallMaterialButton" Click="ApplyWallMaterial_Click" />
                <Button x:Uid="WorkspaceClearWallSelectionButton" Click="ClearWallSelection_Click" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,0">
                <controls:FloorPlanCanvas x:Name="PlanCanvas" />
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <!-- TabView, not Pivot: Pivot silently clips overflowing headers into an
                     unreachable scroll strip once the host column narrows even slightly (see
                     CLAUDE.md's documented XAML compiler/control quirks) — TabView doesn't have
                     that failure mode. -->
                <TabView IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" TabWidthMode="SizeToContent">
                    <TabViewItem x:Uid="WorkspaceCoverageTab" IsClosable="False">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="WorkspaceSignalLegendLabel" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="14" Height="14" Fill="Green" RadiusX="3" RadiusY="3" />
                                    <TextBlock x:Uid="WorkspaceLegendExcellent" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="14" Height="14" Fill="YellowGreen" RadiusX="3" RadiusY="3" />
                                    <TextBlock x:Uid="WorkspaceLegendGood" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="14" Height="14" Fill="Gold" RadiusX="3" RadiusY="3" />
                                    <TextBlock x:Uid="WorkspaceLegendFair" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="14" Height="14" Fill="Orange" RadiusX="3" RadiusY="3" />
                                    <TextBlock x:Uid="WorkspaceLegendWeak" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="14" Height="14" Fill="Red" RadiusX="3" RadiusY="3" />
                                    <TextBlock x:Uid="WorkspaceLegendPoor" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray700Brush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                x:Uid="WorkspacePredictiveOnlyNote"
                                TextWrapping="Wrap"
                                FontSize="{StaticResource FontSizeXs}"
                                Foreground="{StaticResource Gray400Brush}" />
                        </StackPanel>
                    </TabViewItem>

                    <TabViewItem x:Uid="WorkspaceSuggestionsTab" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="WorkspaceSuggestApSectionHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                            <Button
                                x:Uid="WorkspaceSuggestPlacementsButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SuggestPlacements_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                                </Button.Resources>
                            </Button>
                            <TextBlock
                                x:Name="AccessPointSummaryText"
                                Text="{x:Bind ViewModel.AccessPointSummaryDisplay, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource Gray700Brush}" />

                            <Rectangle Height="1" Fill="{StaticResource Gray200Brush}" Margin="0,4,0,0" />
                            <TextBlock x:Uid="WorkspaceGuidedWalkHeader" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />

                            <StackPanel Visibility="{x:Bind ViewModel.IsGuidedWalkIdle, Mode=OneWay}" Spacing="8">
                                <TextBlock
                                    x:Uid="WorkspaceGuidedWalkExplanation"
                                    TextWrapping="Wrap"
                                    FontSize="{StaticResource FontSizeXs}"
                                    Foreground="{StaticResource Gray500Brush}" />
                                <Button
                                    x:Uid="WorkspaceStartGuidedWalkButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.StartGuidedWalkCommand}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsGuidedWalkActive, Mode=OneWay}" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind ViewModel.GuidedWalkProgressDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    FontSize="{StaticResource FontSizeSm}"
                                    Foreground="{StaticResource Gray700Brush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Uid="WorkspaceConfirmWalkPointButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.ConfirmWalkPointCommand}">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                                        </Button.Resources>
                                    </Button>
                                    <Button x:Uid="WorkspaceSkipWalkPointButton" Command="{x:Bind ViewModel.SkipWalkPointCommand}" />
                                    <Button x:Uid="WorkspaceCancelWalkButton" Command="{x:Bind ViewModel.CancelGuidedWalkCommand}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCapturingWalkPoint, Mode=OneWay}" Width="20" Height="20" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Text="{x:Bind ViewModel.GuidedWalkStatusMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasGuidedWalkStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource Gray500Brush}" />

                            <TextBlock
                                x:Uid="WorkspaceGuidedWalkNeedsAdapterNote"
                                Visibility="{x:Bind ViewModel.NeedsAdapterForGuidedWalk, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="{StaticResource FontSizeXs}"
                                Foreground="{StaticResource Gray400Brush}" />
                        </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem x:Uid="WorkspaceAdapterTab" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <ComboBox
                                x:Uid="WorkspaceAdapterField"
                                ItemsSource="{x:Bind ViewModel.Adapters}"
                                SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                                DisplayMemberPath="Name"
                                HorizontalAlignment="Stretch" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    x:Uid="WorkspaceScanButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.ScanCommand}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                                    </Button.Resources>
                                </Button>
                                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
                            </StackPanel>

                            <TextBlock
                                Text="{x:Bind ViewModel.ScanStatusMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasScanStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource Gray500Brush}" />

                            <Button
                                x:Uid="WorkspaceOpenLocationSettingsButton"
                                Visibility="{x:Bind ViewModel.ShowLocationSettingsLink, Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenLocationSettingsCommand}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.ScanResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WlanNetworkDisplay">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{x:Bind Ssid}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray900Brush}" />
                                            <TextBlock Text="{x:Bind SubtitleDisplay}" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Border>
        </Grid>

        <!-- First-run coach-mark tour (skippable) — see WorkspacePage.xaml.cs's onboarding
             sequencing. Content lives here (x:Uid) rather than the always-available Tool Help
             flyout above, since a short guided blurb and a full reference description read
             differently even for the same tool. -->
        <TeachingTip x:Name="OnboardingStep1" x:Uid="WorkspaceOnboardingStep1" Target="{x:Bind SelectToolButton}" ActionButtonClick="OnboardingNext_Click" CloseButtonClick="OnboardingSkip_Click" />
        <TeachingTip x:Name="OnboardingStep2" x:Uid="WorkspaceOnboardingStep2" Target="{x:Bind AddTestPointToolButton}" ActionButtonClick="OnboardingNext_Click" CloseButtonClick="OnboardingSkip_Click" />
        <TeachingTip x:Name="OnboardingStep3" x:Uid="WorkspaceOnboardingStep3" Target="{x:Bind DrawWallToolButton}" ActionButtonClick="OnboardingNext_Click" CloseButtonClick="OnboardingSkip_Click" />
        <TeachingTip x:Name="OnboardingStep4" x:Uid="WorkspaceOnboardingStep4" Target="{x:Bind DeleteToolButton}" ActionButtonClick="OnboardingFinish_Click" CloseButtonClick="OnboardingSkip_Click" />
    </Grid>
</Page>
