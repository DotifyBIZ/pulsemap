<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pulsemap.App.Services"
    mc:Ignorable="d"
    Background="{ThemeResource DotifyColorSurfaceBrush}">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            Severity="Informational"
            IsOpen="{x:Bind ViewModel.HasUpdateAvailable, Mode=OneWay}"
            Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}"
            Margin="0,0,0,16">
            <InfoBar.ActionButton>
                <Button x:Uid="HomeUpdateAvailableActionButton" Command="{x:Bind ViewModel.OpenReleaseCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Bind ViewModel.GreetingDisplay}" FontSize="{StaticResource DotifyText2xl}" FontWeight="SemiBold" Foreground="{ThemeResource DotifyColorOnSurfaceBrush}" />
                <TextBlock x:Uid="HomeSubtitle" FontSize="{StaticResource DotifyTextSm}" Foreground="{ThemeResource DotifyColorOnSurfaceMutedBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{x:Bind ViewModel.WellbeingMessageDisplay}" FontSize="{StaticResource DotifyTextXs}" FontStyle="Italic" Foreground="{ThemeResource DotifyColorOnSurfaceFaintBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource DotifyPrimaryButtonStyle}" Click="NewSurvey_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="HomeNewSurveyButtonLabel" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock x:Uid="HomeRecentSurveysHeader" Grid.Row="2" FontSize="{StaticResource DotifyTextSm}" FontWeight="SemiBold" Foreground="{ThemeResource DotifyColorOnSurfaceBrush}" Margin="0,32,0,14" />

        <Grid Grid.Row="3">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />

            <TextBlock
                x:Uid="HomeNoSurveysMessage"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                TextWrapping="Wrap"
                MaxWidth="420"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="{StaticResource DotifyTextSm}"
                Foreground="{ThemeResource DotifyColorOnSurfaceMutedBrush}" />

            <GridView
                ItemsSource="{x:Bind ViewModel.Surveys}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="SurveysGridView_ItemClick"
                HorizontalAlignment="Left">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="services:SurveySummary">
                        <Border
                            Background="{ThemeResource DotifyColorSurfaceRaisedBrush}"
                            CornerRadius="{StaticResource DotifyRadius}"
                            BorderBrush="{ThemeResource DotifyColorBorderBrush}"
                            BorderThickness="1"
                            Padding="20"
                            Width="320">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource DotifyTextBase}" FontWeight="SemiBold" Foreground="{ThemeResource DotifyColorOnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SiteDescription}" FontSize="{StaticResource DotifyTextSm}" Foreground="{ThemeResource DotifyColorOnSurfaceMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ModifiedAtDisplay}" FontSize="{StaticResource DotifyTextXs}" Foreground="{ThemeResource DotifyColorOnSurfaceFaintBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
