<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.Views.SurveysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pulsemap.App.Services"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="SurveysTitle" Grid.Column="0" FontSize="{StaticResource FontSize2xl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />

            <!-- The library page had no way to start a survey; with an empty library it was a
                 titled blank page whose only exit was back to Home. -->
            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PrimaryButtonStyle}" Click="NewSurvey_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                    <TextBlock x:Uid="HomeNewSurveyButtonLabel" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Margin="0,16,0,0" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />

            <TextBlock
                x:Uid="SurveysNoSurveysMessage"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                TextWrapping="Wrap"
                MaxWidth="420"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="{StaticResource FontSizeSm}"
                Foreground="{StaticResource Gray500Brush}" />

            <GridView
                ItemsSource="{x:Bind ViewModel.Surveys}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="SurveysGridView_ItemClick"
                HorizontalAlignment="Left">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="services:SurveySummary">
                        <Border
                            Background="White"
                            CornerRadius="16"
                            BorderBrush="{StaticResource Gray200Brush}"
                            BorderThickness="1"
                            Padding="20"
                            Width="320">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SiteDescription}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray500Brush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ModifiedAtDisplay}" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray400Brush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button x:Uid="SurveysRenameButton" Tag="{x:Bind}" Click="RenameButton_Click" />
                                    <Button x:Uid="SurveysDeleteButton" Tag="{x:Bind}" Click="DeleteButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
