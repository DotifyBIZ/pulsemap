<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.Views.NewSurveyWizardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pulsemap.App.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource Gray50Brush}">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Uid="WizardTitle" FontSize="{StaticResource FontSize2xl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                <TextBlock x:Uid="WizardSubtitle" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource Gray500Brush}" Margin="0,4,0,0" />
                <!-- Five steps with no indication of which one you're on or how many are left. -->
                <TextBlock
                    Text="{x:Bind ViewModel.StepProgressDisplay, Mode=OneWay}"
                    FontSize="{StaticResource FontSizeXs}"
                    Foreground="{StaticResource Gray400Brush}"
                    Margin="0,6,0,0" />
            </StackPanel>

            <Button x:Uid="WizardCancelButton" Grid.Column="1" VerticalAlignment="Top" Click="Cancel_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="1" Padding="32" Width="560">
                <Grid>
                    <!-- Step 1: Basics -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsBasicsStepVisible, Mode=OneWay}" Spacing="20">
                        <TextBlock x:Uid="WizardStep1Title" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                        <TextBox
                            x:Uid="WizardSurveyNameField"
                            Text="{x:Bind ViewModel.SurveyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Uid="WizardSiteDescriptionField"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="80"
                            Text="{x:Bind ViewModel.SiteDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="WizardSurveyTypeLabel" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold" Foreground="{StaticResource Gray700Brush}" />
                            <RadioButton
                                x:Uid="WizardNewDeploymentRadio"
                                x:Name="NewDeploymentRadio"
                                GroupName="SurveyType"
                                IsChecked="True"
                                Checked="SurveyTypeRadio_Checked" />
                            <RadioButton
                                x:Uid="WizardExistingAuditRadio"
                                x:Name="ExistingAuditRadio"
                                GroupName="SurveyType"
                                Checked="SurveyTypeRadio_Checked" />
                        </StackPanel>
                        <TextBox
                            x:Uid="WizardTargetSsidField"
                            Visibility="{x:Bind ViewModel.IsExistingNetworkAuditSelected, Mode=OneWay}"
                            Text="{x:Bind ViewModel.TargetNetworkSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Step 2: Floor plan -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsFloorPlanStepVisible, Mode=OneWay}" Spacing="20">
                        <TextBlock x:Uid="WizardStep2Title" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                        <StackPanel Spacing="8">
                            <RadioButton
                                x:Uid="WizardRoomListRadio"
                                x:Name="RoomListRadio"
                                GroupName="FloorPlanStyle"
                                IsChecked="True"
                                Checked="FloorPlanStyleRadio_Checked" />
                            <RadioButton
                                x:Uid="WizardImageRadio"
                                x:Name="ImageRadio"
                                GroupName="FloorPlanStyle"
                                Checked="FloorPlanStyleRadio_Checked" />
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.IsRoomListStyleSelected, Mode=OneWay}" Spacing="12">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Rooms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoomListEntry">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="WizardRoomNameField" Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <NumberBox x:Uid="WizardRoomWidthField" Grid.Column="1" SpinButtonPlacementMode="Compact" SmallChange="1" Minimum="0.5" Maximum="1000" Value="{x:Bind WidthMeters, Mode=TwoWay}" />
                                            <NumberBox x:Uid="WizardRoomLengthField" Grid.Column="2" SpinButtonPlacementMode="Compact" SmallChange="1" Minimum="0.5" Maximum="1000" Value="{x:Bind LengthMeters, Mode=TwoWay}" />
                                            <Button x:Uid="WizardRemoveRoomButton" Grid.Column="3" Tag="{x:Bind}" Click="RemoveRoom_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Uid="WizardAddRoomButton" Command="{x:Bind ViewModel.AddRoomCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.IsImageStyleSelected, Mode=OneWay}" Spacing="12">
                            <Button x:Uid="WizardChooseFileButton" Command="{x:Bind ViewModel.PickImageCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedImageFileName, Mode=OneWay}" Foreground="{StaticResource Gray500Brush}" FontSize="{StaticResource FontSizeSm}" />
                            <NumberBox x:Uid="WizardPixelsPerMeterField" SmallChange="1" Minimum="1" Maximum="10000" Value="{x:Bind ViewModel.PixelsPerMeter, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 3: Building details -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsBuildingDetailsStepVisible, Mode=OneWay}" Spacing="20">
                        <TextBlock x:Uid="WizardStep3Title" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                        <TextBlock
                            x:Uid="WizardWallMaterialExplanation"
                            TextWrapping="Wrap"
                            FontSize="{StaticResource FontSizeSm}"
                            Foreground="{StaticResource Gray500Brush}" />
                        <ComboBox x:Uid="WizardWallMaterialField" SelectedIndex="0" SelectionChanged="WallMaterialComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="WizardWallMaterialDrywall" Tag="Drywall" />
                            <ComboBoxItem x:Uid="WizardWallMaterialGlassStandard" Tag="GlassStandard" />
                            <ComboBoxItem x:Uid="WizardWallMaterialGlassLowE" Tag="GlassLowE" />
                            <ComboBoxItem x:Uid="WizardWallMaterialWood" Tag="Wood" />
                            <ComboBoxItem x:Uid="WizardWallMaterialBrick" Tag="Brick" />
                            <ComboBoxItem x:Uid="WizardWallMaterialConcrete" Tag="Concrete" />
                            <ComboBoxItem x:Uid="WizardWallMaterialReinforcedConcrete" Tag="ReinforcedConcrete" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Step 4: Adapter & bands -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsAdapterBandsStepVisible, Mode=OneWay}" Spacing="16">
                        <TextBlock x:Uid="WizardStep4Title" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />
                        <TextBlock
                            x:Uid="WizardBandsExplanation"
                            TextWrapping="Wrap"
                            FontSize="{StaticResource FontSizeSm}"
                            Foreground="{StaticResource Gray500Brush}" />
                        <CheckBox x:Uid="WizardBand24Checkbox" IsChecked="{x:Bind ViewModel.Includes24Ghz, Mode=TwoWay}" />
                        <CheckBox x:Uid="WizardBand5Checkbox" IsChecked="{x:Bind ViewModel.Includes5Ghz, Mode=TwoWay}" />
                        <CheckBox x:Uid="WizardBand6Checkbox" IsChecked="{x:Bind ViewModel.Includes6Ghz, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Step 5: Review -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsReviewStepVisible, Mode=OneWay}" Spacing="16">
                        <TextBlock x:Uid="WizardStep5Title" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" />

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="WizardReviewNameLabel" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.SurveyName, Mode=OneWay}" FontSize="{StaticResource FontSizeBase}" Foreground="{StaticResource Gray900Brush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="WizardReviewSurveyTypeLabel" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.SurveyTypeSummaryDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeBase}" Foreground="{StaticResource Gray900Brush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="WizardReviewFloorPlanLabel" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.FloorPlanSummaryDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeBase}" Foreground="{StaticResource Gray900Brush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="WizardReviewWallMaterialLabel" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.DefaultWallMaterialDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeBase}" Foreground="{StaticResource Gray900Brush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="WizardReviewBandsLabel" FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource Gray500Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.BandsSummaryDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeBase}" Foreground="{StaticResource Gray900Brush}" />
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Page-level, not inside the Review step: the floor-plan picker on step 2 can fail too
             (file too large, unreadable), and an error bar only the last step could show meant
             those failures looked like the button simply didn't work. -->
        <InfoBar
            Grid.Row="2"
            MaxWidth="560"
            HorizontalAlignment="Left"
            Margin="0,16,0,0"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12" Margin="0,20,0,0">
            <Button x:Uid="WizardBackButton" Command="{x:Bind ViewModel.BackCommand}" />
            <Button
                x:Uid="WizardNextButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{x:Bind ViewModel.NextCommand}"
                Visibility="{x:Bind ViewModel.IsNotReviewStep, Mode=OneWay}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                </Button.Resources>
            </Button>
            <Button
                x:Uid="WizardCreateSurveyButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{x:Bind ViewModel.CreateSurveyCommand}"
                Visibility="{x:Bind ViewModel.IsReviewStepVisible, Mode=OneWay}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Primary700Color}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Primary700Color}" />
                </Button.Resources>
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsCreating, Mode=OneWay}" Width="24" Height="24" />
        </StackPanel>
    </Grid>
</Page>
