<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Pulsemap.App.Controls.FloorPlanCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
        <Grid
            x:Name="RootGrid"
            Background="Transparent"
            PointerPressed="RootGrid_PointerPressed"
            PointerMoved="RootGrid_PointerMoved"
            PointerReleased="RootGrid_PointerReleased"
            PointerCaptureLost="RootGrid_PointerCaptureLost"
            PointerExited="RootGrid_PointerExited">
            <Image x:Name="BackgroundLayer" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Canvas x:Name="HeatmapLayer" />
            <Canvas x:Name="WallsLayer" />
            <Canvas x:Name="MarkersLayer" />
            <Canvas x:Name="TooltipLayer" IsHitTestVisible="False">
                <Border
                    x:Name="HeatmapTooltip"
                    Visibility="Collapsed"
                    Background="{StaticResource Gray900Brush}"
                    CornerRadius="4"
                    Padding="6,3">
                    <TextBlock x:Name="HeatmapTooltipText" Foreground="White" FontSize="{StaticResource FontSizeXs}" />
                </Border>
            </Canvas>
        </Grid>
    </ScrollViewer>
</UserControl>
