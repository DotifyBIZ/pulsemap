<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Pulsemap.App.Controls.FloorPlanCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
        <Grid x:Name="RootGrid" Background="Transparent" PointerPressed="RootGrid_PointerPressed">
            <Canvas x:Name="HeatmapLayer" />
            <Canvas x:Name="WallsLayer" />
            <Canvas x:Name="MarkersLayer" />
        </Grid>
    </ScrollViewer>
</UserControl>
