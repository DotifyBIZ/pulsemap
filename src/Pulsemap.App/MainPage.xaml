<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pulsemap.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The back button is the shell-level way out of the pages that aren't in the rail (the New
        Survey wizard, Workspace, snapshot comparison); those pages keep their own explicit
        Back/Cancel buttons too, but relying on those alone made the rail's own highlighted item
        unclickable and left no standard way back.
    -->
    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Visible"
        IsBackEnabled="False"
        IsSettingsVisible="False"
        SelectionChanged="Nav_SelectionChanged"
        ItemInvoked="Nav_ItemInvoked"
        BackRequested="Nav_BackRequested"
        PaneDisplayMode="Left">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavHome" Tag="Home" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSurveys" Tag="Surveys">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavDiagnose" Tag="Diagnose">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="NavSettings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!--
            Content pages (Home, wizard, workspace) are always solid, light cards per
            docs/design-tokens.md — Mica/system theme only shows through the title bar and this
            pane, never through content. Forcing Light here keeps native control foregrounds
            (TextBox, RadioButton, etc.) legible against those explicit white/light backgrounds
            regardless of the user's system theme.
        -->
        <Frame x:Name="ContentFrame" RequestedTheme="Light" />
    </NavigationView>
</Page>
