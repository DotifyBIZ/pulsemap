<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pulsemap.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pulsemap.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="Nav_SelectionChanged"
        PaneDisplayMode="Left">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Surveys" Tag="Surveys">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!--
            Content pages (Home, wizard, workspace) are always solid, light cards per
            docs/design-tokens.md — Mica/system theme only shows through the title bar and this
            pane, never through content. Forcing Light here keeps native control foregrounds
            (TextBox, RadioButton, etc.) legible against those explicit white/light backgrounds
            regardless of the user's system theme.
        -->
        <Frame x:Name="ContentFrame" RequestedTheme="Light" />
    </NavigationView>
</Page>
